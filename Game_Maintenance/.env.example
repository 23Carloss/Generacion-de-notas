# Copy these values into your operating-system environment before starting the backend.
# Do not commit a populated .env file. In Render, set them in the service's
# Environment page (or provide them when the Blueprint prompts you).
DB_URL=jdbc:mysql://localhost:3306/ticketsmantenimiento?zeroDateTimeBehavior=CONVERT_TO_NULL
DB_USER=tu_usuario_de_aplicacion
DB_PASSWORD=tu_contrasena_segura

# Use "none" normally. Set to "create" only once when intentionally rebuilding
# a disposable test schema, then remove it before the next startup.
DB_SCHEMA_ACTION=create

# Comma-separated browser origins allowed to call the API.
APP_ALLOWED_ORIGINS=http://localhost:5173

# Idle timeout for server-side bearer sessions (15 minutes by default).
SESSION_IDLE_TIMEOUT_SECONDS=900

# Maximum JSON request size. Images are additionally restricted to 1 MiB decoded.
MAX_REQUEST_BYTES=1572864

# Set to true only after HTTPS is permanently enabled in production.
APP_ENABLE_HSTS=false
